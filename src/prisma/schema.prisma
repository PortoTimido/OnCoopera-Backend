generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusUsuario {
  ATIVO
  INATIVO
  BLOQUEADO
}

enum StatusEmailEnvio {
  PENDENTE
  ENVIADO
  FALHOU
}

enum TipoApoio {
  ONG
  CLINICA
  TRANSPORTE
  CASA_APOIO
  PSICOLOGO
}

enum StatusApoio {
  RASCUNHO
  ATIVO
  DESATIVADO
}

enum StatusArtigo {
  RASCUNHO
  PUBLICADO
  DESATIVADO
}

enum PermissaoAdministrativa {
  TOTAL
  GERENCIAR_USUARIOS
  GESTAO_CONTEUDOS
  GESTAO_RADAR_APOIO

  @@map("permissao_administrativa")
}

model Usuario {
  id                    String               @id @default(uuid()) @db.Uuid
  nome                  String
  email                 String               @unique
  login                 String               @unique
  senhaHash             String               @map("senha_hash")
  telefone              String
  dataNascimento        DateTime             @map("data_nascimento") @db.Date
  status                StatusUsuario
  trocaSenhaObrigatoria Boolean              @default(false) @map("troca_senha_obrigatoria")
  dataCriacao           DateTime             @default(now()) @map("data_criacao")
  dataAtualizacao       DateTime             @updatedAt @map("data_atualizacao")
  ultimoAcesso          DateTime?            @map("ultimo_acesso")
  senhaTemporariaExpiraEm DateTime?          @map("senha_temporaria_expira_em")
  imagemObjectKey       String?              @map("imagem_object_key")
  paciente              Paciente?
  administrador         Administrador?
  sessoes               SessaoAutenticacao[]
  recuperacoesSenha     RecuperacaoSenha[]

  @@map("usuario")
}

model RecuperacaoSenha {
  id                   String    @id @default(uuid()) @db.Uuid
  usuarioId            String    @map("usuario_id") @db.Uuid
  codigoHash           String    @map("codigo_hash")
  expiraEm             DateTime  @map("expira_em")
  tentativas           Int       @default(0)
  bloqueadoEm          DateTime? @map("bloqueado_em")
  codigoValidadoEm     DateTime? @map("codigo_validado_em")
  resetTokenHash       String?   @map("reset_token_hash")
  resetTokenExpiraEm   DateTime? @map("reset_token_expira_em")
  tokenUtilizadoEm     DateTime? @map("token_utilizado_em")
  criadoEm             DateTime  @default(now()) @map("criado_em")
  usuario              Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("recuperacao_senha")
}

model LimiteRecuperacaoSenha {
  id          String   @id @default(uuid()) @db.Uuid
  emailHash   String   @map("email_hash")
  ipHash      String   @map("ip_hash")
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([emailHash, criadoEm])
  @@index([ipHash, criadoEm])
  @@map("limite_recuperacao_senha")
}

model EmailEnvio {
  id                    String           @id @default(uuid()) @db.Uuid
  tipo                  String
  destinatarioMascarado String           @map("destinatario_mascarado")
  status                StatusEmailEnvio @default(PENDENTE)
  tentativas            Int              @default(0)
  erroCodigo            String?          @map("erro_codigo")
  enviadoEm             DateTime?        @map("enviado_em")
  criadoEm              DateTime         @default(now()) @map("criado_em")

  @@index([tipo, criadoEm])
  @@map("email_envio")
}

model SessaoAutenticacao {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  csrfTokenHash    String    @map("csrf_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("sessao_autenticacao")
}

model Paciente {
  usuarioId        String           @id @map("usuario_id") @db.Uuid
  enderecoId       String           @map("endereco_id") @db.Uuid
  usuario          Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endereco         Endereco         @relation(fields: [enderecoId], references: [id])
  registrosDiarios RegistroDiario[]
  consultas        Consulta[]

  @@index([enderecoId])
  @@map("paciente")
}

model Administrador {
  usuarioId  String                   @id @map("usuario_id") @db.Uuid
  usuario    Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permissoes AdministradorPermissao[]
  artigos    Artigo[]

  @@map("administrador")
}

model AdministradorPermissao {
  administradorId String                  @map("administrador_id") @db.Uuid
  permissao       PermissaoAdministrativa
  administrador   Administrador           @relation(fields: [administradorId], references: [usuarioId], onDelete: Cascade)

  @@id([administradorId, permissao])
  @@map("administrador_permissao")
}

model Endereco {
  id                 String                               @id @default(uuid()) @db.Uuid
  cep                String
  logradouro         String
  numero             String
  complemento        String?
  bairro             String
  cidade             String
  estado             String
  localizacaoPostgis Unsupported("geometry(Point, 4326)") @map("localizacao_postgis")
  pacientes          Paciente[]
  apoios             Apoio[]

  @@map("endereco")
}

model RegistroDiario {
  id           String            @id @default(uuid()) @db.Uuid
  pacienteId   String            @map("paciente_id") @db.Uuid
  dataRegistro DateTime          @map("data_registro") @db.Date
  dataHora     DateTime          @default(now()) @map("data_hora")
  humor        String
  notaVozUrl   String?           @map("nota_voz_url")
  paciente     Paciente          @relation(fields: [pacienteId], references: [usuarioId], onDelete: Cascade)
  sintomas     RegistroSintoma[]

  @@unique([pacienteId, dataRegistro])
  @@index([pacienteId])
  @@map("registro_diario")
}

model RegistroSintoma {
  id               String         @id @default(uuid()) @db.Uuid
  registroDiarioId String         @map("registro_diario_id") @db.Uuid
  sintomaTipo      String         @map("sintoma_tipo")
  intensidade      Int
  descricaoOutro   String?        @map("descricao_outro")
  registroDiario   RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)

  @@index([registroDiarioId])
  @@map("registro_sintoma")
}

model Consulta {
  id              String   @id @default(uuid()) @db.Uuid
  pacienteId      String   @map("paciente_id") @db.Uuid
  medicoNome      String   @map("medico_nome")
  dataHora        DateTime @map("data_hora")
  statusConsulta  String   @map("status_consulta")
  observacao      String?
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @updatedAt @map("data_atualizacao")
  paciente        Paciente @relation(fields: [pacienteId], references: [usuarioId], onDelete: Cascade)

  @@index([pacienteId])
  @@map("consulta")
}

model Apoio {
  id                    String                 @id @default(uuid()) @db.Uuid
  enderecoId            String                 @map("endereco_id") @db.Uuid
  nome                  String
  tipoApoio             TipoApoio              @map("tipo_apoio")
  telefone              String
  descricao             String?                @db.Text
  statusAdministrativo  StatusApoio            @map("status_administrativo")
  dataCriacao           DateTime               @default(now()) @map("data_criacao")
  dataAtualizacao       DateTime               @updatedAt @map("data_atualizacao")
  endereco              Endereco               @relation(fields: [enderecoId], references: [id])
  horariosFuncionamento HorarioFuncionamento[]
  imagens               ApoioImagem[]

  @@index([enderecoId])
  @@map("apoio")
}

model HorarioFuncionamento {
  id            String   @id @default(uuid()) @db.Uuid
  apoioId       String   @map("apoio_id") @db.Uuid
  diaSemana     Int      @map("dia_semana")
  horarioInicio DateTime @map("horario_inicio") @db.Time(0)
  horarioFim    DateTime @map("horario_fim") @db.Time(0)
  apoio         Apoio    @relation(fields: [apoioId], references: [id], onDelete: Cascade)

  @@unique([apoioId, diaSemana, horarioInicio, horarioFim])
  @@index([apoioId])
  @@map("horario_funcionamento")
}

model ApoioImagem {
  id        String @id @default(uuid()) @db.Uuid
  apoioId   String @map("apoio_id") @db.Uuid
  objectKey String @map("object_key")
  ordem     Int
  apoio     Apoio  @relation(fields: [apoioId], references: [id], onDelete: Cascade)

  @@unique([apoioId, ordem])
  @@index([apoioId])
  @@map("apoio_imagem")
}

model Artigo {
  id                  String            @id @default(uuid()) @db.Uuid
  autorId             String            @map("autor_id") @db.Uuid
  titulo              String
  conteudo            String            @db.Text
  tempoLeituraMinutos Int               @map("tempo_leitura_minutos")
  imagemObjectKey     String?           @map("imagem_object_key")
  status              StatusArtigo
  dataCriacao         DateTime          @default(now()) @map("data_criacao")
  dataAtualizacao     DateTime          @updatedAt @map("data_atualizacao")
  dataPublicacao      DateTime?         @map("data_publicacao")
  autor               Administrador     @relation(fields: [autorId], references: [usuarioId])
  categorias          ArtigoCategoria[]
  tags                ArtigoTag[]

  @@index([autorId])
  @@map("artigo")
}

model Categoria {
  id      String            @id @default(uuid()) @db.Uuid
  nome    String            @unique
  artigos ArtigoCategoria[]

  @@map("categoria")
}

model ArtigoCategoria {
  artigoId    String    @map("artigo_id") @db.Uuid
  categoriaId String    @map("categoria_id") @db.Uuid
  artigo      Artigo    @relation(fields: [artigoId], references: [id], onDelete: Cascade)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([artigoId, categoriaId])
  @@index([categoriaId])
  @@map("artigo_categoria")
}

model Tag {
  id      String      @id @default(uuid()) @db.Uuid
  nome    String      @unique
  artigos ArtigoTag[]

  @@map("tag")
}

model ArtigoTag {
  artigoId String @map("artigo_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  artigo   Artigo @relation(fields: [artigoId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([artigoId, tagId])
  @@index([tagId])
  @@map("artigo_tag")
}
